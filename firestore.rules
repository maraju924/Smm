rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isDirectEmailUser(uid) {
      return uid is string && uid.size() >= 10 && uid.size() <= 64 && uid.matches('^usr_[a-f0-9]+$');
    }

    function isOwnerOrEmailUser(uid) {
      return (isSignedIn() && request.auth.uid == uid) || isDirectEmailUser(uid);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'maraju921@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin Markers
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn() || true;
      allow create: if (
        (isSignedIn() && request.auth.uid == userId && (incoming().role == 'user' || isAdmin())) ||
        (isDirectEmailUser(userId) && incoming().uid == userId && incoming().role == 'user')
      );
      allow update: if isAdmin() || (
        isOwnerOrEmailUser(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role'])
      ) || (
        incoming().diff(existing()).affectedKeys().hasOnly(['referralCount', 'referralEarnings', 'unpaidReferralEarnings', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if true;
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow create: if isOwnerOrEmailUser(incoming().userId) && incoming().quantity > 0;
      allow update: if isAdmin() || (
        isOwnerOrEmailUser(resource.data.userId) &&
        incoming().userId == existing().userId &&
        incoming().charge == existing().charge &&
        incoming().quantity == existing().quantity &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startCount', 'remains', 'providerId', 'providerOrderId', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Refills
    match /refills/{refillId} {
      allow get: if true;
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow create: if isOwnerOrEmailUser(incoming().userId);
      allow update: if isAdmin() || (
        isOwnerOrEmailUser(resource.data.userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'providerRefillId'])
      );
      allow delete: if isAdmin();
    }

    // API Keys Index for /api/v2 Server Authentication
    match /api_keys/{apiKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isOwnerOrEmailUser(incoming().uid);
      allow delete: if isSignedIn() || isDirectEmailUser(resource.data.uid);
    }

    // Payments / Deposits
    match /payments/{paymentId} {
      allow get: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow create: if isOwnerOrEmailUser(incoming().userId) && (
        incoming().status == 'pending' ||
        (incoming().status == 'approved' && incoming().verificationMode == 'auto_zinipay')
      );
      allow update: if isAdmin() || (
        isOwnerOrEmailUser(resource.data.userId) &&
        resource.data.status == 'pending' &&
        incoming().userId == resource.data.userId &&
        incoming().amount == resource.data.amount
      );
      allow delete: if isAdmin();
    }

    // Support Tickets
    match /tickets/{ticketId} {
      allow get: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow create: if isOwnerOrEmailUser(incoming().userId);
      allow update: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isDirectEmailUser(resource.data.userId);
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Upstream API Providers (Server Get by ID + Admin Full Control)
    match /providers/{providerId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Promo Codes / Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'usedBy'])
      );
    }

    // Global Site Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SEO Blog Posts
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        incoming().title is string &&
        incoming().slug is string &&
        incoming().content is string
      ) || (
        resource != null &&
        incoming().diff(existing()).affectedKeys().hasOnly(['views'])
      );
      allow delete: if isAdmin();
    }
  }
}

